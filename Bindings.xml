<!--
	Key Bindings → TyGear
	Assign keys, then hover an item tooltip and press the binding.
	This file is loaded automatically; do not list it in the TOC.
-->
<Bindings>
	<!-- header only on the first binding; repeating it loads TYGEAR twice -->
	<Binding name="TYGEAR_TOGGLE_IGNORE" header="TYGEAR">
		TyGearBindingToggleIgnore();
	</Binding>
	<Binding name="TYGEAR_TOGGLE_NEED">
		TyGearBindingToggleNeed();
	</Binding>
</Bindings>
